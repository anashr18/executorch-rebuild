
sudo rm -f /etc/apt/trusted.gpg.d/kitware.gpg
sudo rm -f /etc/apt/keyrings/kitware-archive-keyring.gpg

sudo mkdir -p /etc/apt/keyrings
curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc | \
  gpg --dearmor -o /etc/apt/keyrings/kitware-archive-keyring.gpg


echo "deb [signed-by=/etc/apt/keyrings/kitware-archive-keyring.gpg] \
https://apt.kitware.com/ubuntu/ $(lsb_release -cs) main" | \
sudo tee /etc/apt/sources.list.d/kitware.list > /dev/null


sudo apt update
sudo apt install -y cmake